<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="720.0" prefWidth="1280.0" styleClass="main-container" stylesheets="@EstilosVistas.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tfg.analizador.presentacion.ControladorRegistro">
   <children>
      
      <VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="500.0" styleClass="login-panel">
         <children>
            
            <VBox alignment="CENTER" styleClass="header-bar">
               <children>
                  <Label styleClass="title-label" text="Registrar cuenta" />
               </children>
            </VBox>

            <VBox alignment="CENTER">
               <VBox.margin><Insets top="15.0" /></VBox.margin>
               <children>
                  <Label fx:id="lblError" styleClass="mensaje-error" text="" wrapText="true" textAlignment="CENTER" />
               </children>
            </VBox>
            
            <VBox fx:id="cajaFormulario" spacing="10.0">
               <padding>
                  <Insets bottom="30.0" left="40.0" right="40.0" top="10.0" />
               </padding>
               <children>
                  
                  <Label styleClass="label" text="Correo electrónico / Usuario" />
                  <TextField fx:id="txtEmail" promptText="Introduce tu correo" styleClass="text-field" />
                  
                  <Label text="contraseña">
                     <VBox.margin><Insets top="10.0" /></VBox.margin>
                  </Label>
                  <PasswordField fx:id="txtPass" promptText="***********" styleClass="password-field" />
                  
                  <Label text="Confirmar contraseña">
                     <VBox.margin><Insets top="10.0" /></VBox.margin>
                  </Label>
                  <PasswordField fx:id="txtConfirmarPass" promptText="***********" styleClass="password-field" />
                  
                  <HBox alignment="CENTER_RIGHT">
                     <VBox.margin><Insets bottom="20.0" top="15.0" /></VBox.margin>
                     <children>
                        <Button fx:id="btnRegistrar" onAction="#handleRegistrarAction" styleClass="button-confirm" text="Registrarse" />
                     </children>
                  </HBox>
                  
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label onMouseClicked="#handleVolverLogin" styleClass="link-label" text="¿Ya tienes cuenta? Inicia sesión" />
                     </children>
                  </HBox>
                  
               </children>
            </VBox>

            <VBox fx:id="cajaVerificacion" spacing="10.0" visible="false" managed="false">
               <padding>
                  <Insets bottom="30.0" left="40.0" right="40.0" top="10.0" />
               </padding>
               <children>
                  <Label styleClass="label" text="Código de Verificación (6 dígitos)" />
                  <TextField fx:id="txtCodigo" promptText="Ej: 123456" styleClass="text-field" />
                  
                  <HBox alignment="CENTER_RIGHT">
                     <VBox.margin><Insets bottom="20.0" top="15.0" /></VBox.margin>
                     <children>
                        <Button fx:id="btnVerificar" onAction="#handleVerificarAction" styleClass="button-confirm" text="Verificar y Crear Cuenta" />
                     </children>
                  </HBox>
                  
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label onMouseClicked="#handleCancelarVerificacion" styleClass="link-label" text="&lt; Cancelar y corregir correo" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            
         </children>
      </VBox>
      
   </children>
</StackPane>