<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="711.0" prefWidth="1277.0" styleClass="analizador-container" stylesheets="@EstilosVistas.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tfg.analizador.presentacion.ControladorAnalisis">

    <top>
        <fx:include source="MenuSuperior.fxml" />
    </top>

    <center>
        <HBox spacing="0">
            
            <VBox minWidth="250.0" maxWidth="250.0" prefWidth="250.0" styleClass="panel-lateral-izq">
                <Label alignment="CENTER" maxWidth="Infinity" styleClass="cabecera-analizador" text="Herramientas de Análisis">
                    <font><Font name="System Bold" size="18.0" /></font>
                    <padding><Insets bottom="10.0" top="10.0" /></padding>
                </Label>
                
                <Button onAction="#handleValidarSintaxis" maxWidth="Infinity" text="Validar sintáxis" styleClass="boton-herramienta" prefHeight="35.0" />
                
                <Button onAction="#handleAnalizarProtocolo" maxWidth="Infinity" text="Analizar protocolo" styleClass="boton-herramienta" prefHeight="35.0" />
                
                <Button onAction="#handleGuardarProtocolo" maxWidth="Infinity" text="Guardar protocolo" styleClass="boton-herramienta" prefHeight="35.0" />
                <Button onAction="#handleLimpiarProtocolo" maxWidth="Infinity" text="Limpiar protocolo" styleClass="boton-herramienta" prefHeight="35.0" />
                
                <Label alignment="CENTER" maxWidth="Infinity" text="Actores Disponibles" styleClass="cabecera-seccion">
                    <padding><Insets bottom="8.0" top="8.0" /></padding>
                    <font><Font name="System Bold" size="12.0" /></font>
                </Label>
                
                <ListView fx:id="listaActores" VBox.vgrow="ALWAYS" styleClass="lista-sin-borde" />

                <Button onAction="#handleNuevoActor" maxWidth="Infinity" text="Nuevo actor" styleClass="boton-accion-verde, boton-borde-arriba" prefHeight="40.0">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Button>
            </VBox>

            <StackPane fx:id="contenedorEditor" styleClass="panel-central-blanco" HBox.hgrow="ALWAYS" />

            <VBox minWidth="350.0" maxWidth="350.0" prefWidth="350.0" styleClass="panel-lateral-der">
                <Label alignment="CENTER" maxWidth="Infinity" text="Resultado del análisis" styleClass="cabecera-seccion">
                    <padding><Insets bottom="10.0" top="10.0" /></padding>
                    <font><Font name="System Bold" size="14.0" /></font>
                </Label>
                
                <TableView fx:id="tablaVulnerabilidades" VBox.vgrow="ALWAYS" styleClass="tabla-sin-borde">
                    <columns>
                        <TableColumn fx:id="colVulnNombre" prefWidth="100.0" text="Nombre" />
                        <TableColumn fx:id="colVulnLinea" prefWidth="60.0" text="Línea" />
                        <TableColumn fx:id="colVulnDesc" prefWidth="190.0" text="Descripción" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <Button onAction="#handleGenerarInforme" maxWidth="Infinity" text="Generar Informe" styleClass="boton-accion-verde" prefHeight="40.0">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Button>
            </VBox>

        </HBox>
    </center>
</BorderPane>