<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="720.0" prefWidth="1280.0" styleClass="main-container" stylesheets="@EstilosVistas.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tfg.analizador.presentacion.ControladorRecuperarPass">
   <children>
      <VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="500.0" styleClass="login-panel">
         <children>
            
            <VBox alignment="CENTER" styleClass="header-bar">
               <children>
                  <Label styleClass="title-label" text="Recuperar Contraseña" />
               </children>
            </VBox>

            <VBox alignment="CENTER">
               <VBox.margin><Insets top="15.0" /></VBox.margin>
               <children>
                  <Label fx:id="lblError" styleClass="mensaje-error" text="" wrapText="true" textAlignment="CENTER" />
               </children>
            </VBox>
            
            <VBox fx:id="cajaEmail" spacing="10.0">
               <padding><Insets bottom="30.0" left="40.0" right="40.0" top="10.0" /></padding>
               <children>
                  <Label styleClass="label" text="Introduce el correo de tu cuenta" />
                  <TextField fx:id="txtEmail" promptText="correo@ejemplo.com" styleClass="text-field" />
                  
                  <HBox alignment="CENTER_RIGHT">
                     <VBox.margin><Insets bottom="20.0" top="15.0" /></VBox.margin>
                     <children>
                        <Button fx:id="btnEnviarCodigo" onAction="#handleEnviarCodigo" styleClass="button-confirm" text="Enviar código de seguridad" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label onMouseClicked="#handleVolverLogin" styleClass="link-label" text="&lt; Volver al Login" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <VBox fx:id="cajaVerificacion" spacing="10.0" visible="false" managed="false">
               <padding><Insets bottom="30.0" left="40.0" right="40.0" top="10.0" /></padding>
               <children>
                  <Label styleClass="label" text="Código de Verificación (6 dígitos)" />
                  <TextField fx:id="txtCodigo" promptText="Ej: 123456" styleClass="text-field" />
                  
                  <HBox alignment="CENTER_RIGHT">
                     <VBox.margin><Insets bottom="20.0" top="15.0" /></VBox.margin>
                     <children>
                        <Button fx:id="btnVerificar" onAction="#handleVerificarCodigo" styleClass="button-confirm" text="Verificar Código" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label onMouseClicked="#handleCancelar" styleClass="link-label" text="&lt; Cancelar y volver" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <VBox fx:id="cajaNuevaPass" spacing="10.0" visible="false" managed="false">
               <padding><Insets bottom="30.0" left="40.0" right="40.0" top="10.0" /></padding>
               <children>
                  <Label text="Nueva Contraseña" />
                  <PasswordField fx:id="txtNuevaPass" promptText="***********" styleClass="password-field" />
                  
                  <Label text="Confirmar Nueva Contraseña">
                     <VBox.margin><Insets top="10.0" /></VBox.margin>
                  </Label>
                  <PasswordField fx:id="txtConfirmarPass" promptText="***********" styleClass="password-field" />
                  
                  <HBox alignment="CENTER_RIGHT">
                     <VBox.margin><Insets bottom="20.0" top="15.0" /></VBox.margin>
                     <children>
                        <Button fx:id="btnActualizar" onAction="#handleActualizarPass" styleClass="button-confirm" text="Actualizar Contraseña" />
                     </children>
                  </HBox>
               </children>
            </VBox>

         </children>
      </VBox>
   </children>
</StackPane>