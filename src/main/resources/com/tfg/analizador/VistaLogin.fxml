<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="711.0" prefWidth="1277.0" styleClass="main-container" stylesheets="@EstilosVistas.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tfg.analizador.presentacion.ControladorLogin">
   <children>
      
      <VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="542.0" prefHeight="288.0" prefWidth="542.0" styleClass="login-panel" StackPane.alignment="CENTER">
         <children>
            
            <VBox alignment="CENTER" prefHeight="19.0" prefWidth="523.0" styleClass="header-bar">
               <children>
                  <Label styleClass="title-label" text="Iniciar sesión" />
               </children>
            </VBox>
            
            <VBox prefHeight="249.0" prefWidth="566.0" spacing="10.0">
               <padding>
                  <Insets bottom="30.0" left="40.0" right="40.0" top="20.0" />
               </padding>
               <children>
                  
                  <Label text="Correo / Usuario" />
                  <TextField fx:id="txtUsuario" promptText="Introduce tu usuario" styleClass="text-field" />
                  
                  <Label text="contraseña">
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </Label>
                  <PasswordField fx:id="txtPass" promptText ="***********" styleClass="password-field" />

                  <HBox alignment="CENTER_RIGHT">
                     <VBox.margin>
                        <Insets top="5.0" />
                     </VBox.margin>
                     <children>
                        <Label onMouseClicked="#handleRecuperarPassAction" styleClass="link-label" text="¿Has olvidado tu contraseña? Pulsa aquí" style="-fx-text-fill: #2980B9; -fx-underline: true; -fx-cursor: hand; -fx-font-size: 12px;"/>
                     </children>
                  </HBox>

                  <VBox alignment="CENTER">
                     <VBox.margin><Insets top="15.0" /></VBox.margin>
                     <children>
                        <Label fx:id="lblError" styleClass="mensaje-error" text="" />
                     </children>
                  </VBox>
                  
                  <HBox alignment="CENTER_RIGHT" spacing="15.0">
                     <VBox.margin>
                        <Insets top="30.0" />
                     </VBox.margin>
                     <children>
                        <Button fx:id="btnRegistrar" onAction="#handleRegistrarAction" styleClass="button-register" text="Registrase" />
                        
                        <HBox HBox.hgrow="ALWAYS" />
                        
                        <Button fx:id="btnConfirmar" onAction="#handleConfirmarAction" styleClass="button-confirm" text="Confirmar" />
                     </children>
                  </HBox>
                  
               </children>
            </VBox>
            
         </children>
      </VBox>
      
   </children>
</StackPane>
